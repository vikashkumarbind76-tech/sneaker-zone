{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nuiaqcktaxrlkdgkapkp.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sneaker-zone",
      "version": "0.1.0",
      "title": "Sneaker Zone"
    },
    "tools": [
      {
        "name": "search_products",
        "title": "Search products",
        "description": "Search the Sneaker Zone catalog by keyword, brand, category, price range or featured/new flags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "description": "Free-text match on product name or description.",
              "type": "string"
            },
            "brand": {
              "description": "Brand name, e.g. PUMA, Red Tape, Adidas.",
              "type": "string"
            },
            "category": {
              "description": "Product category.",
              "type": "string"
            },
            "max_price": {
              "description": "Maximum sale price in INR.",
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_price": {
              "description": "Minimum sale price in INR.",
              "type": "number",
              "minimum": 0
            },
            "featured_only": {
              "description": "Only return featured products.",
              "type": "boolean"
            },
            "new_only": {
              "description": "Only return newly added products.",
              "type": "boolean"
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Get full details and images for one Sneaker Zone product by id or slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "description": "Numeric product id.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "slug": {
              "description": "Product slug.",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in customer's Sneaker Zone orders with items and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by order status, e.g. confirmed, pending.",
              "type": "string"
            },
            "limit": {
              "description": "Max orders to return (default 10).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_order",
        "title": "Get order",
        "description": "Get one of the signed-in customer's Sneaker Zone orders by order id, with line items.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "order_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The order UUID."
            }
          },
          "required": [
            "order_id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
